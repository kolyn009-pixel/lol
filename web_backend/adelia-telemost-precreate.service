[Unit]
Description=Adelia Telemost Precreate Worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/adelia-current
EnvironmentFile=-/etc/tutorbot/adelia.env
Environment=PYTHONPATH=/opt/adelia-current
ExecStart=/opt/tutorbot/venv/bin/python -c "import database; database.DB_NAME='/opt/tutorbot/tutor.db'; from web_backend.telemost_precreate_worker import main; main()"
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
