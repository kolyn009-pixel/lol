[Unit]
Description=Adelia Telemost Precreate Worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/tutorbot
EnvironmentFile=-/etc/tutorbot/adelia.env
ExecStart=/opt/tutorbot/venv/bin/python -m web_backend.telemost_precreate_worker
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
