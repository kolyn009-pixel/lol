[Unit]
Description=Adelia TutorBot Web API
After=network.target tutorbot.service

[Service]
Type=simple
WorkingDirectory=/opt/tutorbot
EnvironmentFile=-/etc/tutorbot/adelia.env
Environment=ADELIA_WEB_HOST=127.0.0.1
Environment=ADELIA_WEB_PORT=8765
ExecStart=/opt/tutorbot/venv/bin/python -m web_backend.api_v6
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
