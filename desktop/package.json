{
  "name": "adelia-desktop",
  "version": "0.2.0",
  "private": true,
  "description": "Аделия — приложение для обучения и преподавания",
  "main": "bootstrap.js",
  "scripts": {
    "start": "node generate_assets.js && node sync_role_assets.js && electron .",
    "selftest": "node sync_role_assets.js && node selftest.js",
    "dist": "node generate_assets.js && node sync_role_assets.js && electron-builder",
    "dist:win": "node generate_assets.js && node sync_role_assets.js && electron-builder --win nsis",
    "dist:mac": "node generate_assets.js && node sync_role_assets.js && electron-builder --mac"
  },
  "dependencies": {"electron-updater": "6.6.2"},
  "devDependencies": {"electron": "38.0.0", "electron-builder": "26.0.12"},
  "build": {
    "appId": "ru.adeliatutor.desktop",
    "productName": "Аделия",
    "artifactName": "Adelia-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "files": ["bootstrap.js", "lesson_workspace.js", "desktop_ux.js", "lesson_layout.js", "role_startup.js", "bundled_ui.js", "bundled_ui_manifest.js", "role_assets/**/*", "start.html", "start.css", "start.js", "main.js", "preload.js", "package.json", "build/icon.png"],
    "directories": {"output": "dist", "buildResources": "build"},
    "protocols": [{"name": "Аделия", "schemes": ["adelia"]}],
    "publish": [{"provider": "generic", "url": "https://adeliatutor.ru/desktop-updates/"}],
    "win": {"target": ["nsis"], "requestedExecutionLevel": "asInvoker", "icon": "build/icon.png"},
    "mac": {"target": ["dmg", "zip"], "category": "public.app-category.education", "icon": "build/icon.png"},
    "nsis": {"oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "createStartMenuShortcut": true, "shortcutName": "Аделия"}
  }
}
