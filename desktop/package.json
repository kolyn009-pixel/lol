{
  "name": "adelia-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Adelia TutorBot desktop shell",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "selftest": "node selftest.js",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac dmg"
  },
  "devDependencies": {
    "electron": "38.0.0",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "ru.adeliatutor.desktop",
    "productName": "Аделия",
    "artifactName": "Adelia-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "files": ["main.js", "preload.js", "selftest.js", "package.json"],
    "directories": {"output": "dist"},
    "win": {"target": ["nsis"], "requestedExecutionLevel": "asInvoker"},
    "mac": {"target": ["dmg"], "category": "public.app-category.education"},
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Аделия"
    }
  }
}
