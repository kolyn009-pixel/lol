# Пример переменных окружения TutorBot. Скопируйте в .env (или /etc/tutorbot.env
# для systemd EnvironmentFile) и заполните. Код сам .env не читает (python-dotenv
# не используется): переменные должны быть заданы в окружении процесса.

# --- Telegram ---
# Токен бота от @BotFather (bot.py, vk_adapter/attachment_bridge.py, vk_adapter/channel_delivery.py)
BOT_TOKEN=

# --- VK (vk_adapter/) ---
# Токен сообщества VK с доступом к сообщениям
VK_TOKEN=
# Числовой ID сообщества VK (для Long Poll)
VK_GROUP_ID=
# Версия VK API (по умолчанию 5.199)
VK_API_VERSION=5.199

# --- AI-ассистент (ai_assistant/, ux_final/handlers.py, preflight_check.py) ---
# Ключ OpenRouter
OPENROUTER_API_KEY=
# Базовый URL OpenAI-совместимого API (по умолчанию https://openrouter.ai/api/v1)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Модель по умолчанию
AI_MODEL=openrouter/free
# Таймаут запроса к AI, секунды
AI_TIMEOUT_SECONDS=25
# JSON-файл с настройками AI-провайдеров (по умолчанию /etc/tutorbot_ai_providers.json)
TUTORBOT_AI_PROVIDERS_FILE=/etc/tutorbot_ai_providers.json

# --- Тестовый режим / selftest-скрипты (database.py) ---
# Каталог для тестовых данных (по умолчанию ../tutorbot_data рядом с репо)
# TUTORBOT_TEST_DATA_DIR=
# Путь к тестовой БД (по умолчанию $TUTORBOT_TEST_DATA_DIR/tutor_test.db)
# TUTORBOT_TEST_DB=

# Примечание: TZ бот выставляет сам из настройки bot_timezone в БД (bot.py), задавать не нужно.
